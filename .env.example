# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun.
# .env repoya girmez (.gitignore). Supabase şifresi grupta değil, özel mesajla paylaşılır.
#
# Windows (cmd):   copy .env.example .env
# macOS / Linux:   cp .env.example .env

# Supabase > Connect > Session pooler (port 5432) JDBC adresi; sonuna sslmode=require eklenir.
DB_URL=jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<proje-ref>
DB_PASSWORD=

# JWT (HS256) imzalama anahtarı: en az 32 bayt. Kimlik doğrulama eklendiğinde kullanılır.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Sadece local profili için (docker compose local-db servisi)
LOCAL_DB_URL=jdbc:postgresql://localhost:5432/vacation
LOCAL_DB_USERNAME=vacation
LOCAL_DB_PASSWORD=
